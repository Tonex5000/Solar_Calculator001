# Supabase product database — USE A READ-ONLY KEY.
# Either a Postgres role restricted to SELECT, or a key covered by an RLS
# policy that denies INSERT/UPDATE/DELETE. The code is read-only by design,
# but enforce it at the credential level too (see supabase_client.py).
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_read_only_supabase_key_here

# NVIDIA NIM (OpenAI-compatible) — used by langchain_agent.py
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional override (default shown):
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
