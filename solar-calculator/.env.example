# Groq API Key - Get free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Server port (optional, defaults to 3001)
PORT=3001

# ============================================
# RUNNING THE SERVER
# ============================================
#
# Option 1: Python (recommended)
#   pip install -r requirements.txt
#   python server.py
#
# Option 2: Node.js
#   npm install
#   node server.js
# ============================================